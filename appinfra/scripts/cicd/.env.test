# Default environment variables for Docker Compose testing
# This file is committed to the repository
# For local customization, copy to .env.local (gitignored)

# Docker Compose project name (prefixes container/volume/network names)
COMPOSE_PROJECT_NAME=infra-cicd

# Python version (overridden by docker-compose.override files)
PYTHON_VERSION=3.12

# PostgreSQL connection (docker-compose postgres service)
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# Coverage file location
COVERAGE_FILE=/workspace/.deploy-coverage/.coverage
