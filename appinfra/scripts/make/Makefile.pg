# Makefile.pg - PostgreSQL Management Targets
#
# Provides: pg.server.up, pg.server.down, pg.info, pg.clean, pg, etc.
# Requires: areyousure (from Makefile.utils)
#
# Configuration variables (set in Makefile before include):
#   INFRA_PG_CONFIG_FILE - Config filename (empty = use INFRA_DEFAULT_CONFIG_FILE)
#   INFRA_PG_CONFIG_KEY  - Key in YAML for postgres config (default: pgserver)
#   INFRA_PG_DATABASES   - Space-separated list of databases to manage (default: empty)
#   INFRA_PG_HOST        - PostgreSQL host (default: 127.0.0.1)
#   INFRA_PG_USER        - PostgreSQL user (default: postgres)
#
# YAML config structure:
#   pgserver:
#     name: myapp-pg
#     version: "18"          # Required unless image is specified
#     port: 5432
#     image: pgvector/pgvector:pg18  # Optional: custom Docker image
#     postgres_conf:         # Optional: PostgreSQL -c parameters
#       max_connections: 500
#       shared_preload_libraries:
#         - pg_stat_statements
#         - timescaledb
#     replica:               # Optional: enables replication mode targets
#       enabled: true
#       port: 5433
#
#   dbs:
#     main:
#       url: "postgresql://..."
#       extensions:          # Optional: CREATE EXTENSION per database
#         - vector
#         - timescaledb

# Flag to indicate Postgres Makefile is loaded
PG_INCLUDED := true

# Container runtime (defensive defaults; Makefile.config sets these centrally
# when included, but the ?= keeps this file usable in minimal include sets).
INFRA_CONTAINER_CMD ?= docker
INFRA_COMPOSE_CMD   ?= docker compose

# Path to this Makefile's directory
pg_local := $(dir $(realpath $(lastword $(MAKEFILE_LIST))))

# Newline for $(subst) - must be exactly two newlines between define/endef
define _pg_newline


endef
# Extract all PG config values in one call (sets PG_CONTAINER_NAME, PG_VERSION, PG_PORT, PG_IMAGE, PG_REPLICA_ENABLED, PG_PORT_R, PG_MAX_CONNECTIONS, PG_SHARED_PRELOAD_LIBRARIES, PG_WORK_MEM, PG_AUTOVACUUM)
# pg-config.sh outputs pipe-separated values; $(subst) converts pipes to newlines for $(eval)
# Args: config_file, config_key, etc_dir, default_config_file
# Gated on PyYAML availability so `make setup` can run from a fresh venv (see Makefile.config).
# When skipped, PG_* variables are left undefined — recipes that need them will fail at
# recipe time, but parse-time (and `make setup`) completes.
ifdef _INFRA_PYYAML_OK
$(eval $(subst |,$(_pg_newline),$(shell $(pg_local)/../pg-config.sh "$(INFRA_PG_CONFIG_FILE)" $(INFRA_PG_CONFIG_KEY) $(ETC_DIR) $(INFRA_DEFAULT_CONFIG_FILE))))
endif

# Validate replica config and hide replication targets from help when disabled
ifeq ($(PG_REPLICA_ENABLED),true)
ifeq ($(PG_PORT_R),)
$(error replica.enabled is true but replica.port is not defined in config file)
endif
else
INFRA_DISABLE_TARGETS += pg.server.up.repl pg.standby
endif

PG_HOST := $(INFRA_PG_HOST)
PG_USER := $(INFRA_PG_USER)

# Resolved image: use explicit pgserver.image when set, else docker.io/postgres:<version>.
# Pre-resolved here (rather than via ${IMAGE:-...} in the compose YAML) because
# podman-compose does not recursively expand nested shell-style defaults. The default
# is fully qualified (docker.io/...) because podman does not assume docker.io for
# unqualified image names — docker accepts the qualified form transparently.
# When neither image nor version is configured, leaves IMAGE empty so the YAML's
# ${IMAGE:?} produces a clean "IMAGE: required variable not set" error.
# Must be defined BEFORE the _INFRA_PG_IMAGE export below (:= is immediate).
PG_RESOLVED_IMAGE := $(if $(PG_IMAGE),$(PG_IMAGE),$(if $(PG_VERSION),docker.io/postgres:$(PG_VERSION)))

# Wire vars exported to pg.sh (internal contract; underscore prefix marks it
# as subject to change and distinct from the public INFRA_PG_* / INFRA_PGSERVER_*
# configuration surface). INFRA_CONTAINER_CMD is exported in Makefile.config.
_INFRA_PG_CONTAINER_NAME           := $(PG_CONTAINER_NAME)
_INFRA_PG_VERSION                  := $(PG_VERSION)
_INFRA_PG_PORT                     := $(PG_PORT)
_INFRA_PG_PORT_R                   := $(PG_PORT_R)
_INFRA_PG_REPLICA_ENABLED          := $(PG_REPLICA_ENABLED)
_INFRA_PG_HOST                     := $(PG_HOST)
_INFRA_PG_USER                     := $(PG_USER)
_INFRA_PG_IMAGE                    := $(PG_RESOLVED_IMAGE)
_INFRA_PG_MAX_CONNECTIONS          := $(PG_MAX_CONNECTIONS)
_INFRA_PG_SHARED_PRELOAD_LIBRARIES := $(PG_SHARED_PRELOAD_LIBRARIES)
_INFRA_PG_WORK_MEM                 := $(PG_WORK_MEM)
_INFRA_PG_AUTOVACUUM               := $(PG_AUTOVACUUM)
_INFRA_PG_DATABASES                := $(INFRA_PG_DATABASES)
export _INFRA_PG_CONTAINER_NAME _INFRA_PG_VERSION _INFRA_PG_PORT _INFRA_PG_PORT_R
export _INFRA_PG_REPLICA_ENABLED _INFRA_PG_HOST _INFRA_PG_USER
export _INFRA_PG_IMAGE _INFRA_PG_MAX_CONNECTIONS _INFRA_PG_SHARED_PRELOAD_LIBRARIES
export _INFRA_PG_WORK_MEM _INFRA_PG_AUTOVACUUM _INFRA_PG_DATABASES
export INFRA_COMPOSE_CMD INFRA_CONTAINER_CMD

##@ Postgres

# =============================================================================
# Single Instance Mode (default)
# =============================================================================

pg.server.up: ## starts postgres server (single instance, waits for readiness)
	@_INFRA_PG_MODE=single $(pg_local)/../pg.sh up
.PHONY: pg.server.up

pg.server.down: areyousure ## stops postgres server (auto-detects mode, verifies removal)
	@$(pg_local)/../pg.sh down
.PHONY: pg.server.down

pg.server.wait.up: ## waits for postgres to accept connections (30s timeout, auto-detects mode)
	@$(pg_local)/../pg.sh wait-up
.PHONY: pg.server.wait.up

pg.server.wait.down: ## waits for postgres containers to be fully removed (30s timeout)
	@$(pg_local)/../pg.sh wait-down
.PHONY: pg.server.wait.down

pg.server.reboot: areyousure ## restarts postgres server (auto-detects mode, waits for readiness)
	@$(pg_local)/../pg.sh reboot
.PHONY: pg.server.reboot

pg.server.logs: ## tails postgres server logs (auto-detects mode)
	@$(pg_local)/../pg.sh logs
.PHONY: pg.server.logs

pg.server.clean: areyousure ## removes all postgres containers, volumes, images, and networks (WARNING: deletes all data)
	@$(pg_local)/../pg.sh erase
.PHONY: pg.server.clean

pg.server.clean.internal:: # Internal: cleanup without confirmation (used by clean.full)
	@$(pg_local)/../pg.sh erase
.PHONY: pg.server.clean.internal

# =============================================================================
# Replication Mode (primary + standby) - only when replica_enabled: true
# =============================================================================

ifeq ($(PG_REPLICA_ENABLED),true)
pg.server.up.repl: ## starts postgres replication (primary + standby, waits for readiness)
	@_INFRA_PG_MODE=repl $(pg_local)/../pg.sh up
.PHONY: pg.server.up.repl
endif


# =============================================================================
# Database Operations (work with both single and replication modes)
# =============================================================================

pg.info: ## comprehensive server and database information
	@$(pg_local)/../pg.sh info
.PHONY: pg.info

pg.info.short: ## short status summary
	@$(pg_local)/../pg.sh info --short
.PHONY: pg.info.short

pg.clean.internal:: ## drops all configured databases (no confirmation; for downstream chaining)
	@$(pg_local)/../pg.sh clean
.PHONY: pg.clean.internal

pg.clean:: areyousure ## cleans all databases (with confirmation)
	@$(pg_local)/../pg.sh clean
.PHONY: pg.clean

pg: ## connects to postgres db (primary)
	@$(pg_local)/../pg.sh psql
.PHONY: pg

ifeq ($(PG_REPLICA_ENABLED),true)
pg.standby: ## connects to standby postgres db (replication mode only)
	@$(pg_local)/../pg.sh psql --target standby
.PHONY: pg.standby
endif

pg.top: ## pgtop for primary server
	@$(pg_local)/../pg.sh top
.PHONY: pg.top
