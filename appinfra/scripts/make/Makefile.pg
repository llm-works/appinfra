# Makefile.pg - PostgreSQL Management Targets
#
# Provides: pg.server.up, pg.server.down, pg.info, pg.clean, pg, etc.
# Requires: areyousure (from Makefile.utils)
#
# Configuration variables (set in Makefile before include):
#   APPINFRA_PG_CONFIG_FILE - Config filename (empty = use APPINFRA_DEFAULT_CONFIG_FILE)
#   APPINFRA_PG_CONFIG_KEY  - Key in YAML for postgres config (default: pgserver)
#   APPINFRA_PG_DATABASES   - Space-separated list of databases to manage (default: empty)
#   APPINFRA_PG_HOST        - PostgreSQL host (default: 127.0.0.1)
#   APPINFRA_PG_USER        - PostgreSQL user (default: postgres)
#
# The config file loads when a pg target runs, the way the application loads
# it: !include resolves and INFRA_* overrides apply (INFRA_PGSERVER_PASS, ...),
# and an override must target a path the file declares. Make itself never reads
# it, so a target that needs a setting (replication: pgserver.replica) reports
# it missing when it runs.
#
# YAML config structure:
#   pgserver:
#     name: myapp-pg
#     version: "18"          # Required unless image is specified
#     port: 5432
#     image: pgvector/pgvector:pg18  # Optional: custom Docker image
#     bind: 127.0.0.1        # Optional: host address the port listens on (default 127.0.0.1)
#     pass: ''               # Optional: set (INFRA_PGSERVER_PASS) to require a password
#     postgres_conf:         # Optional: PostgreSQL -c parameters
#       max_connections: 500
#       shared_preload_libraries:
#         - pg_stat_statements
#         - timescaledb
#     replica:               # Optional: needed by the replication mode targets
#       enabled: true
#       port: 5433
#
#   dbs:
#     main:
#       url: "postgresql://..."
#       extensions:          # Optional: CREATE EXTENSION per database
#         - vector
#         - timescaledb

# Flag to indicate Postgres Makefile is loaded
_APPINFRA_PG_INCLUDED := true

# Path to this Makefile's directory, taken before the include below changes
# MAKEFILE_LIST
_APPINFRA_PG_MAKE_DIR := $(dir $(realpath $(lastword $(MAKEFILE_LIST))))

# Defaults (container runtime included) are declared in Makefile.config; load
# it when the project has not
ifndef _APPINFRA_CONFIG_LOADED
include $(_APPINFRA_PG_MAKE_DIR)Makefile.config
endif

# The config file the pg targets (and examples.check's pg probe) load
_APPINFRA_PG_CONFIG_PATH = $(APPINFRA_ETC_DIR)/$(or $(APPINFRA_PG_CONFIG_FILE),$(APPINFRA_DEFAULT_CONFIG_FILE))

# Every pg target runs a pg.sh verb through pg_make, which loads the config file
# and projects it into the _APPINFRA_PG_* wire variables, as `appinfra pg` does.
# Loading it here, while make parses, would cost every make invocation ~0.1s.
_APPINFRA_PG = $(PYTHON) -m appinfra.cli.tools.pg_make "$(_APPINFRA_PG_CONFIG_PATH)" "$(APPINFRA_PG_CONFIG_KEY)"

# Make's own settings reach pg_make as wire variables, and win over the config
# (internal contract; the underscore prefix marks it as subject to change and
# distinct from the public APPINFRA_PG_* / INFRA_PGSERVER_* configuration surface).
# APPINFRA_CONTAINER_CMD is exported in Makefile.config.
_APPINFRA_PG_HOST      := $(APPINFRA_PG_HOST)
_APPINFRA_PG_USER      := $(APPINFRA_PG_USER)
_APPINFRA_PG_DATABASES := $(APPINFRA_PG_DATABASES)
export _APPINFRA_PG_HOST _APPINFRA_PG_USER _APPINFRA_PG_DATABASES
export APPINFRA_COMPOSE_CMD APPINFRA_CONTAINER_CMD

##@ Postgres

# =============================================================================
# Single Instance Mode (default)
# =============================================================================

pg.server.up: ## starts postgres server (single instance, waits for readiness)
	@_APPINFRA_PG_MODE=single $(_APPINFRA_PG) up
.PHONY: pg.server.up

pg.server.down: areyousure ## stops postgres server (auto-detects mode, verifies removal)
	@$(_APPINFRA_PG) down
.PHONY: pg.server.down

pg.server.wait.up: ## waits for postgres to accept connections and sets the role's password (30s timeout)
	@$(_APPINFRA_PG) wait-up
.PHONY: pg.server.wait.up

pg.server.wait.down: ## waits for postgres containers to be fully removed (30s timeout)
	@$(_APPINFRA_PG) wait-down
.PHONY: pg.server.wait.down

pg.server.reboot: areyousure ## restarts postgres server (auto-detects mode, waits for readiness)
	@$(_APPINFRA_PG) reboot
.PHONY: pg.server.reboot

pg.server.logs: ## tails postgres server logs (auto-detects mode)
	@$(_APPINFRA_PG) logs
.PHONY: pg.server.logs

pg.server.clean: areyousure ## removes all postgres containers, volumes, images, and networks (WARNING: deletes all data)
	@$(MAKE) pg.server.clean.internal
.PHONY: pg.server.clean

pg.server.clean.internal:: # Internal: cleanup without confirmation (used by clean.full)
	@$(_APPINFRA_PG) erase
.PHONY: pg.server.clean.internal

# =============================================================================
# Replication Mode (primary + standby) - needs pgserver.replica
# =============================================================================

pg.server.up.repl: ## starts postgres replication, primary + standby (replication mode only: needs pgserver.replica.enabled)
	@_APPINFRA_PG_MODE=repl $(_APPINFRA_PG) up
.PHONY: pg.server.up.repl


# =============================================================================
# Database Operations (work with both single and replication modes)
# =============================================================================

pg.info: ## comprehensive server and database information
	@$(_APPINFRA_PG) info
.PHONY: pg.info

pg.info.short: ## short status summary
	@$(_APPINFRA_PG) info --short
.PHONY: pg.info.short

pg.clean.internal:: ## drops all configured databases (no confirmation; for downstream chaining)
	@$(_APPINFRA_PG) clean
.PHONY: pg.clean.internal

pg.clean:: areyousure ## cleans all databases (with confirmation)
	@$(MAKE) pg.clean.internal
.PHONY: pg.clean

pg: ## connects to postgres db (primary)
	@$(_APPINFRA_PG) psql
.PHONY: pg

pg.standby: ## connects to standby postgres db (replication mode only: needs pgserver.replica.enabled)
	@$(_APPINFRA_PG) psql --target standby
.PHONY: pg.standby

pg.top: ## pgtop for primary server
	@$(_APPINFRA_PG) top
.PHONY: pg.top
