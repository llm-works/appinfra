# Makefile.env - Python Environment Detection
#
# Resolves the Python interpreter, PYTHON:
# 1. PYTHON, with the precedence of every setting (Makefile.config): the
#    command line, the environment, Makefile.local, the project Makefile
# 2. python3 on PATH, which an activated venv, conda or pyenv puts first
# 3. Error
# An empty PYTHON from the environment or the command line stops make.
# Recipes use $(PYTHON).
#
# Usage in other Makefiles:
#   include path/to/Makefile.env
#
# To override, either:
#   export PYTHON=/path/to/your/python
#   # or
#   make <target> PYTHON=/path/to/your/python
#   # or
#   echo 'PYTHON := /path/to/your/python' > Makefile.local

# Makefile.config loads Makefile.local and the framework defaults; include it
# here when the project Makefile has not, so that holds for every layout
ifndef _APPINFRA_CONFIG_LOADED
include $(dir $(lastword $(MAKEFILE_LIST)))Makefile.config
endif

# `make config` shows the resolved interpreter and its source. The PATH lookup
# gives an absolute path, which the [ -x ] checks in Makefile.install need; the
# redirect makes make run it through the shell, where command is a builtin.
ifdef PYTHON
  _APPINFRA_PYTHON_SOURCE := $(call _APPINFRA_SOURCE,PYTHON)
else
  PYTHON := $(shell command -v python3 2>/dev/null)
  _APPINFRA_PYTHON_SOURCE := default, python3 on PATH
  ifeq ($(PYTHON),)
    $(error No Python found: python3 is not on PATH. Activate an environment, or set PYTHON, e.g. PYTHON := /path/to/python in Makefile.local)
  endif
endif
