# Makefile.env - Python Environment Detection
#
# Resolves the Python interpreter. Inputs: APPINFRA_PYTHON and PYTHON (the
# standard name). Priority:
# 1. APPINFRA_PYTHON from the environment or the command line
# 2. PYTHON from the environment or the command line
# 3. APPINFRA_PYTHON from the project Makefile or Makefile.local
# 4. PYTHON from the project Makefile or Makefile.local
# 5. ~/.venv/bin/python
# 6. Error
# An empty value from the environment or the command line stops make
# (Makefile.config). After resolution both
# APPINFRA_PYTHON and PYTHON hold the resolved path; recipes use $(PYTHON).
# APPINFRA_PYTHON selects appinfra's interpreter when PYTHON is exported for
# another tool.
#
# Usage in other Makefiles:
#   include path/to/Makefile.env
#
# To override, either:
#   export APPINFRA_PYTHON=/path/to/your/python
#   # or
#   make <target> PYTHON=/path/to/your/python
#   # or
#   echo 'APPINFRA_PYTHON ?= /path/to/your/python' > Makefile.local

# Makefile.config loads Makefile.local and the framework defaults; include it
# here when the project Makefile has not, so that holds for every layout
ifndef _APPINFRA_CONFIG_LOADED
include $(dir $(lastword $(MAKEFILE_LIST)))Makefile.config
endif

# Select by origin, not by whether a value is set: Makefile.local is already
# loaded here, and a value from the environment or the command line must
# outrank one from the project Makefile or Makefile.local. override: a value
# from the command line would otherwise keep its own.
ifneq ($(call _APPINFRA_EXTERNAL,APPINFRA_PYTHON),)
  _APPINFRA_PYTHON_SOURCE := APPINFRA_PYTHON (environment or command line)
  override PYTHON := $(APPINFRA_PYTHON)
else ifneq ($(call _APPINFRA_EXTERNAL,PYTHON),)
  _APPINFRA_PYTHON_SOURCE := PYTHON (environment or command line)
else ifdef APPINFRA_PYTHON
  _APPINFRA_PYTHON_SOURCE := Makefile or Makefile.local (APPINFRA_PYTHON)
  override PYTHON := $(APPINFRA_PYTHON)
else ifdef PYTHON
  _APPINFRA_PYTHON_SOURCE := Makefile or Makefile.local (PYTHON)
else ifneq ($(wildcard $(HOME)/.venv/bin/python),)
  _APPINFRA_PYTHON_SOURCE := ~/.venv (default)
  override PYTHON := $(HOME)/.venv/bin/python
else
  $(error No Python environment found. Options: 1) Create ~/.venv virtualenv, 2) Set APPINFRA_PYTHON or PYTHON, 3) Create Makefile.local with APPINFRA_PYTHON ?= path)
endif

override APPINFRA_PYTHON := $(PYTHON)

##@ Environment

env: ## Show current environment configuration
	@echo "Environment Configuration"
	@echo "========================="
	@echo ""
	@echo "Python:"
	@echo "  Path:    $(PYTHON)"
	@echo "  Version: $$($(PYTHON) --version 2>&1)"
	@echo "  Source:  $(_APPINFRA_PYTHON_SOURCE)"
	@echo ""
	@echo "Makefile.local: $$(if [ -f Makefile.local ]; then echo "exists"; else echo "not present"; fi)"
	@if [ -f Makefile.local ]; then echo "  Contents:"; cat Makefile.local | sed 's/^/    /'; fi
	@echo ""
	@echo "Project Root: $(CURDIR)"
	@echo ""
	@echo "Development (APPINFRA_DEV_*):"
	@echo "  PKG_NAME:       $(APPINFRA_DEV_PKG_NAME)"
	@echo "  CQ_STRICT:      $(APPINFRA_DEV_CQ_STRICT)"
	@echo "  PROJECT_ROOT:   $(APPINFRA_DEV_PROJECT_ROOT)"
	@echo "  INSTALL_EXTRAS: $(APPINFRA_DEV_INSTALL_EXTRAS)"
	@echo "  CHECK_SCRIPT:   $(APPINFRA_DEV_CHECK_SCRIPT)"
	@echo ""
	@echo "Testing (APPINFRA_PYTEST_*):"
	@echo "  TESTS_DIR:      $(APPINFRA_PYTEST_TESTS_DIR)"
	@echo "  COVERAGE_PKG:   $(APPINFRA_PYTEST_COVERAGE_PKG)"
	@echo "  WORKERS:        $(APPINFRA_PYTEST_WORKERS)"
	@echo "  ARGS:           $(APPINFRA_PYTEST_ARGS)"
	@echo ""
	@echo "Docs (APPINFRA_DOCS_*):"
	@echo "  CONFIG_FILE:    $(if $(APPINFRA_DOCS_CONFIG_FILE),$(APPINFRA_DOCS_CONFIG_FILE),(using default))"
	@echo "  OUTPUT_DIR:     $(APPINFRA_DOCS_OUTPUT_DIR)"
	@echo ""
	@echo "PostgreSQL (APPINFRA_PG_*):"
	@echo "  CONFIG_FILE:    $(if $(APPINFRA_PG_CONFIG_FILE),$(APPINFRA_PG_CONFIG_FILE),(using default))"
	@echo "  CONFIG_KEY:     $(APPINFRA_PG_CONFIG_KEY)"
	@echo "  DATABASES:      $(APPINFRA_PG_DATABASES)"
	@echo "  HOST:           $(APPINFRA_PG_HOST)"
	@echo "  USER:           $(APPINFRA_PG_USER)"
	@echo ""
	@echo "Other:"
	@echo "  APPINFRA_DRY_RUN:         $(APPINFRA_DRY_RUN)"
	@echo "  APPINFRA_CLEAN_PRESERVE:  $(APPINFRA_CLEAN_PRESERVE)"
	@echo "  APPINFRA_DISABLE_TARGETS: $(APPINFRA_DISABLE_TARGETS)"
	@echo "  APPINFRA_DISABLE_GROUPS:  $(APPINFRA_DISABLE_GROUPS)"
	@echo ""
	@echo "Config overrides (INFRA_*):"
	@echo "  INFRA_TEST_LOGGING_LEVEL: $${INFRA_TEST_LOGGING_LEVEL:-<not set>}"
	@echo "  INFRA_LOGGING_LEVEL:      $${INFRA_LOGGING_LEVEL:-<not set>}"
.PHONY: env
