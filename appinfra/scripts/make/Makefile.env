# Makefile.env - Python Environment Detection
#
# Determines which Python interpreter to use. Priority:
# 1. APPINFRA_ENV_PYTHON environment variable (highest priority)
# 2. PYTHON environment variable (legacy, for backward compatibility)
# 3. Makefile.local file (project-local override, gitignored)
# 4. ~/.venv/bin/python (default virtualenv location)
# 5. Error with helpful message
#
# Configuration variables (set in Makefile before include):
#   APPINFRA_ENV_PYTHON - Path to Python interpreter
#
# Usage in other Makefiles:
#   include path/to/Makefile.env
#
# To override, either:
#   export APPINFRA_ENV_PYTHON=/path/to/your/python
#   # or (legacy)
#   export PYTHON=/path/to/your/python
#   # or
#   echo 'APPINFRA_ENV_PYTHON ?= /path/to/your/python' > Makefile.local
#
# Note: Use ?= in Makefile.local so env vars can still override when needed.

# Makefile.config loads Makefile.local and the framework defaults; include it
# here when the project Makefile has not, so that holds for every layout
ifndef _APPINFRA_CONFIG_LOADED
include $(dir $(lastword $(MAKEFILE_LIST)))Makefile.config
endif

# Select by origin, not by whether a value is set: Makefile.local is already
# loaded here, and a value from the environment or the command line must
# outrank one from the project Makefile or Makefile.local
# An empty value counts as unset, so an exported VAR= falls through
_env_origins := environment environment override command line
ifneq ($(and $(filter $(_env_origins),$(origin APPINFRA_ENV_PYTHON)),$(strip $(APPINFRA_ENV_PYTHON))),)
  _PYTHON_SOURCE := APPINFRA_ENV_PYTHON (environment or command line)
  # override: a PYTHON given on the command line would otherwise keep its value
  override PYTHON := $(APPINFRA_ENV_PYTHON)
else ifneq ($(and $(filter $(_env_origins),$(origin PYTHON)),$(strip $(PYTHON))),)
  _PYTHON_SOURCE := PYTHON (environment or command line, legacy)
else ifdef APPINFRA_ENV_PYTHON
  _PYTHON_SOURCE := Makefile or Makefile.local (APPINFRA_ENV_PYTHON)
  PYTHON := $(APPINFRA_ENV_PYTHON)
else ifdef PYTHON
  _PYTHON_SOURCE := Makefile or Makefile.local (PYTHON)
endif

# If PYTHON not already set, detect it
ifndef PYTHON
  ifneq ($(wildcard $(HOME)/.venv/bin/python),)
    PYTHON := $(HOME)/.venv/bin/python
    _PYTHON_SOURCE := ~/.venv (default)
  else
    $(error No Python environment found. Options: 1) Create ~/.venv virtualenv, 2) Set APPINFRA_ENV_PYTHON env var, 3) Create Makefile.local with APPINFRA_ENV_PYTHON=path)
  endif
endif

# Set APPINFRA_ENV_PYTHON from PYTHON for consistency
APPINFRA_ENV_PYTHON := $(PYTHON)

##@ Environment

env: ## Show current environment configuration
	@echo "Environment Configuration"
	@echo "========================="
	@echo ""
	@echo "Python:"
	@echo "  Path:    $(PYTHON)"
	@echo "  Version: $$($(PYTHON) --version 2>&1)"
	@echo "  Source:  $(_PYTHON_SOURCE)"
	@echo ""
	@echo "Makefile.local: $$(if [ -f Makefile.local ]; then echo "exists"; else echo "not present"; fi)"
	@if [ -f Makefile.local ]; then echo "  Contents:"; cat Makefile.local | sed 's/^/    /'; fi
	@echo ""
	@echo "Project Root: $(CURDIR)"
	@echo ""
	@echo "Development (APPINFRA_DEV_*):"
	@echo "  PKG_NAME:       $(APPINFRA_DEV_PKG_NAME)"
	@echo "  CQ_STRICT:      $(APPINFRA_DEV_CQ_STRICT)"
	@echo "  PROJECT_ROOT:   $(APPINFRA_DEV_PROJECT_ROOT)"
	@echo "  INSTALL_EXTRAS: $(APPINFRA_DEV_INSTALL_EXTRAS)"
	@echo "  CHECK_SCRIPT:   $(APPINFRA_DEV_CHECK_SCRIPT)"
	@echo ""
	@echo "Testing (APPINFRA_PYTEST_*):"
	@echo "  TESTS_DIR:      $(APPINFRA_PYTEST_TESTS_DIR)"
	@echo "  COVERAGE_PKG:   $(APPINFRA_PYTEST_COVERAGE_PKG)"
	@echo "  WORKERS:        $(APPINFRA_PYTEST_WORKERS)"
	@echo "  ARGS:           $(APPINFRA_PYTEST_ARGS)"
	@echo ""
	@echo "Docs (APPINFRA_DOCS_*):"
	@echo "  CONFIG_FILE:    $(if $(APPINFRA_DOCS_CONFIG_FILE),$(APPINFRA_DOCS_CONFIG_FILE),(using default))"
	@echo "  OUTPUT_DIR:     $(APPINFRA_DOCS_OUTPUT_DIR)"
	@echo ""
	@echo "PostgreSQL (APPINFRA_PG_*):"
	@echo "  CONFIG_FILE:    $(if $(APPINFRA_PG_CONFIG_FILE),$(APPINFRA_PG_CONFIG_FILE),(using default))"
	@echo "  CONFIG_KEY:     $(APPINFRA_PG_CONFIG_KEY)"
	@echo "  DATABASES:      $(APPINFRA_PG_DATABASES)"
	@echo "  HOST:           $(APPINFRA_PG_HOST)"
	@echo "  USER:           $(APPINFRA_PG_USER)"
	@echo ""
	@echo "Other:"
	@echo "  APPINFRA_DRY_RUN:         $(APPINFRA_DRY_RUN)"
	@echo "  APPINFRA_CLEAN_PRESERVE:  $(APPINFRA_CLEAN_PRESERVE)"
	@echo "  APPINFRA_DISABLE_TARGETS: $(APPINFRA_DISABLE_TARGETS)"
	@echo "  APPINFRA_DISABLE_GROUPS:  $(APPINFRA_DISABLE_GROUPS)"
	@echo ""
	@echo "Config overrides (INFRA_*):"
	@echo "  INFRA_TEST_LOGGING_LEVEL: $${INFRA_TEST_LOGGING_LEVEL:-<not set>}"
	@echo "  INFRA_LOGGING_LEVEL:      $${INFRA_LOGGING_LEVEL:-<not set>}"
.PHONY: env
