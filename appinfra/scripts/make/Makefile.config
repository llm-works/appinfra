# Makefile.config - Configuration Protocol for Infra Makefile Framework
#
# This file provides:
# 1. Config file loading (Makefile.local for overrides)
# 2. Target filtering mechanism
# 3. Default values for all configuration variables
#
# Precedence of a setting (highest to lowest):
# 1. The command line                  make test APPINFRA_X=v
# 2. The environment                   APPINFRA_X=v make test
# 3. Makefile.local, assigned with :=  APPINFRA_X := v
# 4. The project Makefile, with ?=     APPINFRA_X ?= v (before the include)
# 5. The defaults defined here
# A := or = in the project Makefile pins the value against the environment
# (make replaces an environment value with a makefile assignment before this
# file runs); Makefile.local and the command line still override it.
#
# For selective module inclusion, include individual Makefiles instead
# of using Makefile.all. See Makefile.all header for examples.
#
# Usage:
#   include path/to/Makefile.config
#   # or use Makefile.all which includes this automatically
#
# Makefile.env includes this file itself when a Makefile has not, so every
# layout loads Makefile.local, the defaults and the checks below.

_APPINFRA_CONFIG_LOADED := 1

# This file's directory, taken before any include changes MAKEFILE_LIST
_APPINFRA_CONFIG_MAKE_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

# ============================================================================
# Nested Projects
# ============================================================================

# A make run inside another appinfra project's make (e.g. $(MAKE) -C
# submodules/appinfra) inherits that project's exported settings as
# environment values, which outrank this project's Makefile and Makefile.local
# and cannot be undone here. Such a make stops; a recursive make in the same
# project is fine.
ifneq ($(_APPINFRA_PROJECT_DIR),)
ifneq ($(_APPINFRA_PROJECT_DIR),$(CURDIR))
$(error running inside the make of $(_APPINFRA_PROJECT_DIR), whose settings would replace \
    this project's; run it with a clean environment: \
    env -i HOME="$$HOME" PATH="$$PATH" $$(MAKE) -C $(CURDIR) <target>)
endif
endif
_APPINFRA_PROJECT_DIR := $(CURDIR)
export _APPINFRA_PROJECT_DIR

# ============================================================================
# Empty Values
# ============================================================================

# An exported VAR= or a command-line VAR= is still defined, so ?= would not
# assign Makefile.local's value or the default to it, and the setting would
# run empty. An empty APPINFRA_* or PYTHON from the environment or the command
# line therefore stops make. Checked in the top-level make only: a sub-make
# inherits the values its parent exported, some empty by default.
ifeq ($(MAKELEVEL),0)
_APPINFRA_EMPTY := $(foreach _APPINFRA_V,$(filter APPINFRA_% PYTHON,$(.VARIABLES)),\
    $(if $(and $(filter environment command,$(firstword $(origin $(_APPINFRA_V)))),\
        $(if $(strip $($(_APPINFRA_V))),,1)),$(_APPINFRA_V)))
ifneq ($(strip $(_APPINFRA_EMPTY)),)
$(error $(strip $(_APPINFRA_EMPTY)) set but empty: unset it or give it a value)
endif
endif

# ============================================================================
# Local Overrides
# ============================================================================

# Optional Makefile.local: per-checkout settings, gitignored
_APPINFRA_LOCAL_FILE := $(strip \
    $(if $(wildcard $(CURDIR)/Makefile.local),$(CURDIR)/Makefile.local,))

# Each setting's source and value are recorded before Makefile.local is
# included: origin reports "file" for both the project Makefile and
# Makefile.local, and a Makefile.local assignment replaces an environment
# value, which the record keeps.
_APPINFRA_SOURCE_OF = $(strip $(if $(filter command,$(firstword $(origin $(1)))),command-line,\
    $(if $(filter environment,$(firstword $(origin $(1)))),environment,Makefile)))
_APPINFRA_PRE := $(filter APPINFRA_% PYTHON,$(.VARIABLES))
$(foreach _APPINFRA_V,$(_APPINFRA_PRE),\
    $(eval _APPINFRA_PRE_SRC_$(_APPINFRA_V) := $(call _APPINFRA_SOURCE_OF,$(_APPINFRA_V)))\
    $(eval _APPINFRA_PRE_VAL_$(_APPINFRA_V) := $$($(_APPINFRA_V))))

# Include it if found; settings in it are assigned with := so they replace
# the project Makefile's ?= values
ifneq ($(_APPINFRA_LOCAL_FILE),)
-include $(_APPINFRA_LOCAL_FILE)
endif

# A setting is from Makefile.local when it is new since the record, or its
# source or value changed
_APPINFRA_EQ = $(if $(subst x$(1),,x$(2))$(subst x$(2),,x$(1)),,1)
_APPINFRA_LOCAL_SET = $(strip $(if $(filter $(1),$(_APPINFRA_PRE)),\
    $(if $(and $(call _APPINFRA_EQ,$(_APPINFRA_PRE_SRC_$(1)),$(call _APPINFRA_SOURCE_OF,$(1))),\
        $(call _APPINFRA_EQ,$(_APPINFRA_PRE_VAL_$(1)),$($(1)))),,1),1))

# The environment outranks Makefile.local: every setting from the environment
# gets the environment's value back, in case Makefile.local reassigned it.
# (The command line already outranks every makefile assignment.) A plain :=,
# not override: override would silently ignore an assignment after the
# framework include.
_APPINFRA_FROM_ENV := $(foreach _APPINFRA_V,$(_APPINFRA_PRE),\
    $(if $(filter environment,$(_APPINFRA_PRE_SRC_$(_APPINFRA_V))),$(_APPINFRA_V)))
$(foreach _APPINFRA_V,$(_APPINFRA_FROM_ENV),\
    $(eval $(_APPINFRA_V) := $$(_APPINFRA_PRE_VAL_$(_APPINFRA_V))))

# NAME:source for every setting set so far, for `make config` and Makefile.env;
# taken before the defaults below, so a setting not listed has its default
_APPINFRA_SOURCES := $(foreach _APPINFRA_V,$(filter APPINFRA_% PYTHON,$(.VARIABLES)),\
    $(_APPINFRA_V):$(strip $(if $(filter $(_APPINFRA_V),$(_APPINFRA_FROM_ENV)),environment,\
        $(if $(call _APPINFRA_LOCAL_SET,$(_APPINFRA_V)),Makefile.local,\
            $(_APPINFRA_PRE_SRC_$(_APPINFRA_V))))))
_APPINFRA_SOURCE = $(or $(patsubst $(1):%,%,$(filter $(1):%,$(_APPINFRA_SOURCES))),default)

# ============================================================================
# Target Filtering
# ============================================================================

# Space-separated list of targets to disable (e.g., "pg.clean docs.serve")
APPINFRA_DISABLE_TARGETS ?=

# Space-separated list of target prefixes to disable (e.g., "pg. docs.")
APPINFRA_DISABLE_GROUPS ?=

# Helper macro to check if a target is disabled
# Usage: $(call _APPINFRA_CHECK_TARGET,target_name)
# Returns: shell command to exit 0 if disabled, empty otherwise
define _APPINFRA_CHECK_TARGET
$(if $(filter $1,$(APPINFRA_DISABLE_TARGETS)),@echo "Target '$1' is disabled via APPINFRA_DISABLE_TARGETS" && exit 0,$(if $(strip $(foreach _APPINFRA_G,$(APPINFRA_DISABLE_GROUPS),$(if $(filter $(_APPINFRA_G)%,$1),yes,))),@echo "Target '$1' is disabled via APPINFRA_DISABLE_GROUPS" && exit 0,))
endef

# ============================================================================
# Dry Run Mode
# ============================================================================

# Set APPINFRA_DRY_RUN=true to show commands without executing
APPINFRA_DRY_RUN ?= false

# Export for subprocesses
export APPINFRA_DRY_RUN

# Helper macro for dry-run aware command execution
# Usage: $(call _APPINFRA_RUN_OR_SHOW,command_description,actual_command)
define _APPINFRA_RUN_OR_SHOW
@if [ "$(call _APPINFRA_BOOL_VALUE,APPINFRA_DRY_RUN)" = "true" ]; then \
	echo "[DRY RUN] Would run: $(1)"; \
else \
	$(2); \
fi
endef

# ============================================================================
# Bootstrap Probes
# ============================================================================

# PyYAML availability probe. Some modules call helper scripts via $(shell ...)
# at parse time, and those scripts import yaml. During `make setup` from a fresh
# venv, PyYAML isn't installed yet — those modules must gate their parse-time
# shell-outs with `ifdef _APPINFRA_PYYAML_OK` so Make can finish parsing and run
# setup. Targets that depend on the parsed config will then work on the next
# invocation, once setup has installed dependencies.
_APPINFRA_PYYAML_OK := $(shell python3 -c "import yaml" 2>/dev/null && echo 1)

# ============================================================================
# Validation Helpers
# ============================================================================

# Validate APPINFRA_DEV_PKG_NAME points to a valid Python package
# Usage: $(call _APPINFRA_VALIDATE_PKG_NAME,package_name)
# Call at the start of targets that require a valid package
define _APPINFRA_VALIDATE_PKG_NAME
$(if $(wildcard $(1)/__init__.py),,$(error \
Package '$(1)' is not a valid Python package. \
Check APPINFRA_DEV_PKG_NAME in your Makefile. Run 'make doctor' for diagnostics.))
endef

# Check if a tool is available
# Usage: $(call _APPINFRA_CHECK_TOOL,tool_name,install_hint)
define _APPINFRA_CHECK_TOOL
@command -v $(1) >/dev/null 2>&1 || { \
	echo ""; \
	echo "ERROR: $(1) not found"; \
	echo ""; \
	echo "To fix: $(2)"; \
	echo ""; \
	exit 1; \
}
endef

# ============================================================================
# Default Values for Configuration Variables
# ============================================================================

# appinfra's scripts directory (what `appinfra scripts-path` prints); a project
# Makefile may set it before including this file to locate the framework
APPINFRA_SCRIPTS ?= $(abspath $(_APPINFRA_CONFIG_MAKE_DIR)..)
# It must name the copy this file was loaded from, or later includes and
# check.sh would come from another copy. Makefile.local is read after the
# project Makefile included this file, too late to choose the copy. realpath:
# the same directory may be reached through a symlink.
ifneq ($(realpath $(APPINFRA_SCRIPTS)),$(realpath $(_APPINFRA_CONFIG_MAKE_DIR)..))
$(error APPINFRA_SCRIPTS=$(APPINFRA_SCRIPTS), but the framework was loaded from \
    $(realpath $(_APPINFRA_CONFIG_MAKE_DIR)..); set APPINFRA_SCRIPTS before the include \
    (project Makefile, environment or command line), not in Makefile.local)
endif

# The interpreter, PYTHON, is resolved in Makefile.env
# Interpreters `make install` / `make setup` install into (recursive: expands
# to the resolved PYTHON)
APPINFRA_PYTHON_ENVS ?= $(PYTHON)

# DEV module
APPINFRA_DEV_PKG_NAME ?= appinfra
APPINFRA_DEV_CQ_STRICT ?= false
APPINFRA_DEV_CQ_SPDX ?= false
APPINFRA_DEV_CQ_LINT_SELECT ?= C90,SIM,RET,PIE,PERF,FURB,C4
APPINFRA_DEV_CQ_DUP ?= warn
APPINFRA_DEV_CQ_DEAD ?= warn
APPINFRA_DEV_TEST_HEALTH ?= warn
APPINFRA_DEV_TEST_HEALTH_THRESHOLD ?= 90
APPINFRA_DEV_TEST_HEALTH_OVERRIDE_THRESHOLD ?= 15
APPINFRA_DEV_CHECK_EXAMPLES ?= false
APPINFRA_DEV_DOCSTRING_THRESHOLD ?= 80
APPINFRA_DEV_PROJECT_ROOT ?= $(CURDIR)
APPINFRA_DEV_CHECK_SCRIPT ?= $(APPINFRA_SCRIPTS)/check.sh
APPINFRA_DEV_CQ_EXCLUDE ?=
APPINFRA_DEV_INSTALL_EXTRAS ?=
APPINFRA_DEV_MYPY_FLAGS ?=
APPINFRA_DEV_SKIP_TARGETS ?=

# PYTEST module
APPINFRA_PYTEST_COVERAGE_PKG ?= $(APPINFRA_DEV_PKG_NAME)
APPINFRA_PYTEST_COVERAGE_MARKERS ?= unit
APPINFRA_PYTEST_COVERAGE_THRESHOLD ?= 80
APPINFRA_PYTEST_TESTS_DIR ?= tests
APPINFRA_PYTEST_PERF_DIR ?= tests
APPINFRA_PYTEST_WORKERS ?=
APPINFRA_PYTEST_ARGS ?=
APPINFRA_PYTEST_HANG_DUMP_SECONDS ?= 120

# Config module - APPINFRA_ETC_DIR and default config file
APPINFRA_ETC_DIR ?= $(CURDIR)/etc
APPINFRA_DEFAULT_CONFIG_FILE ?= infra.yaml

# DOCS module (empty = use APPINFRA_DEFAULT_CONFIG_FILE)
APPINFRA_DOCS_CONFIG_FILE ?=
APPINFRA_DOCS_OUTPUT_DIR ?= .site

# PG module (empty = use APPINFRA_DEFAULT_CONFIG_FILE)
APPINFRA_PG_CONFIG_FILE ?=
APPINFRA_PG_CONFIG_KEY ?= pgserver
APPINFRA_PG_DATABASES ?=
APPINFRA_PG_HOST ?= 127.0.0.1
APPINFRA_PG_USER ?= postgres

# Container runtime (used by the PG module)
# Override examples (Podman):
#   APPINFRA_CONTAINER_CMD ?= podman
#   APPINFRA_COMPOSE_CMD   ?= podman compose
APPINFRA_CONTAINER_CMD ?= docker
APPINFRA_COMPOSE_CMD ?= docker compose

# Export so helper shell scripts (pg.sh) inherit the runtime
export APPINFRA_CONTAINER_CMD
export APPINFRA_COMPOSE_CMD

# CLEAN module
APPINFRA_CLEAN_PRESERVE ?= .data .logs .GRADING.md

# Runtime settings read from the environment by appinfra's Python code and
# recipes; declared here so every APPINFRA_* name has one registry
# Answer yes to confirmations: the areyousure prompt of destructive targets
# (Makefile.utils) and appinfra.ui.prompts
APPINFRA_YES ?= false
# Progress logging without interactive (TTY) rendering
APPINFRA_NON_INTERACTIVE ?= false
# PostgreSQL URL the default pg_test_config fixture (appinfra.db.pg.testing)
# uses; unset skips the tests that need it
APPINFRA_TEST_PG_URL ?=
# Exported so a value from the project Makefile or Makefile.local reaches them
export APPINFRA_YES APPINFRA_NON_INTERACTIVE APPINFRA_TEST_PG_URL

# ============================================================================
# Setting Registry and Validation
# ============================================================================

# Every setting declared above, once, by type. A name not listed stops make,
# and each value is checked against its type here, after the defaults.
# - boolean: true, 1, y, yes or false, 0, n, no; any case. The same sets are
#   in scripts/_settings.sh and appinfra/ui/_env.py.
# - mode: false, warn or strict; any case
# - percent: a number from 0 to 100, e.g. 80 or 95.5
# - integer: a whole number, 0 or more
# - workers: empty, auto, logical or a whole number above 0 (pytest-xdist -n)
# - text: anything
# Settings keep the spelling they were given, and are exported that way:
# check.sh and Python parse it by the same rules. Make's own readers go
# through _APPINFRA_BOOL_VALUE / _APPINFRA_ON / _APPINFRA_MODE_VALUE at use,
# so a value assigned after the framework include still takes effect (and is
# checked when read). Rewriting the variables here would need override, which
# would silently ignore such a later assignment.
_APPINFRA_BOOLEANS := APPINFRA_DRY_RUN APPINFRA_DEV_CQ_STRICT APPINFRA_DEV_CQ_SPDX \
    APPINFRA_DEV_CHECK_EXAMPLES APPINFRA_YES APPINFRA_NON_INTERACTIVE
_APPINFRA_MODES := APPINFRA_DEV_CQ_DUP APPINFRA_DEV_CQ_DEAD APPINFRA_DEV_TEST_HEALTH
_APPINFRA_PERCENTS := APPINFRA_DEV_DOCSTRING_THRESHOLD APPINFRA_PYTEST_COVERAGE_THRESHOLD \
    APPINFRA_DEV_TEST_HEALTH_THRESHOLD APPINFRA_DEV_TEST_HEALTH_OVERRIDE_THRESHOLD
_APPINFRA_INTEGERS := APPINFRA_PYTEST_HANG_DUMP_SECONDS
_APPINFRA_WORKERS := APPINFRA_PYTEST_WORKERS
_APPINFRA_TEXTS := APPINFRA_SCRIPTS APPINFRA_PYTHON_ENVS \
    APPINFRA_DISABLE_TARGETS APPINFRA_DISABLE_GROUPS \
    APPINFRA_DEV_PKG_NAME APPINFRA_DEV_CQ_LINT_SELECT APPINFRA_DEV_PROJECT_ROOT \
    APPINFRA_DEV_CHECK_SCRIPT APPINFRA_DEV_CQ_EXCLUDE APPINFRA_DEV_INSTALL_EXTRAS \
    APPINFRA_DEV_MYPY_FLAGS APPINFRA_DEV_SKIP_TARGETS \
    APPINFRA_PYTEST_COVERAGE_PKG APPINFRA_PYTEST_COVERAGE_MARKERS APPINFRA_PYTEST_TESTS_DIR \
    APPINFRA_PYTEST_PERF_DIR APPINFRA_PYTEST_ARGS \
    APPINFRA_ETC_DIR APPINFRA_DEFAULT_CONFIG_FILE APPINFRA_DOCS_CONFIG_FILE \
    APPINFRA_DOCS_OUTPUT_DIR APPINFRA_PG_CONFIG_FILE APPINFRA_PG_CONFIG_KEY \
    APPINFRA_PG_DATABASES APPINFRA_PG_HOST APPINFRA_PG_USER \
    APPINFRA_CONTAINER_CMD APPINFRA_COMPOSE_CMD APPINFRA_CLEAN_PRESERVE \
    APPINFRA_TEST_PG_URL
_APPINFRA_SETTINGS := $(_APPINFRA_BOOLEANS) $(_APPINFRA_MODES) $(_APPINFRA_PERCENTS) \
    $(_APPINFRA_INTEGERS) $(_APPINFRA_WORKERS) $(_APPINFRA_TEXTS)

# An unknown name from the environment only warns: the environment is shared
# with projects on other appinfra versions, which may know names this one does
# not. From a makefile or the command line it stops make.
_APPINFRA_UNKNOWN := $(filter-out $(_APPINFRA_SETTINGS),$(filter APPINFRA_%,$(.VARIABLES)))
_APPINFRA_UNKNOWN_ENV := $(foreach _APPINFRA_V,$(_APPINFRA_UNKNOWN),\
    $(if $(filter environment,$(call _APPINFRA_SOURCE,$(_APPINFRA_V))),$(_APPINFRA_V)))
_APPINFRA_UNKNOWN_SET := $(filter-out $(_APPINFRA_UNKNOWN_ENV),$(_APPINFRA_UNKNOWN))
ifneq ($(_APPINFRA_UNKNOWN_SET),)
$(error $(_APPINFRA_UNKNOWN_SET): not an appinfra setting; APPINFRA_* names belong to appinfra, \
    see make config or makefile-customization.md for the settings)
endif
ifeq ($(MAKELEVEL),0)
ifneq ($(strip $(_APPINFRA_UNKNOWN_ENV)),)
$(warning $(strip $(_APPINFRA_UNKNOWN_ENV)): not a setting of this appinfra version, ignored \
    (from the environment))
endif
endif

_APPINFRA_TRUE := true 1 y yes
_APPINFRA_FALSE := false 0 n no
_APPINFRA_LOWER = $(subst A,a,$(subst B,b,$(subst C,c,$(subst D,d,$(subst E,e,$(subst F,f,\
    $(subst G,g,$(subst H,h,$(subst I,i,$(subst J,j,$(subst K,k,$(subst L,l,$(subst M,m,\
    $(subst N,n,$(subst O,o,$(subst P,p,$(subst Q,q,$(subst R,r,$(subst S,s,$(subst T,t,\
    $(subst U,u,$(subst V,v,$(subst W,w,$(subst X,x,$(subst Y,y,$(subst Z,z,$(1)))))))))))))))))))))))))))
# $(call _APPINFRA_BOOL,NAME): true or false for NAME's value, empty if it is
# neither; _APPINFRA_BOOL_OF takes the lower-cased value itself. strip: the
# line continuations above put spaces into the results
_APPINFRA_BOOL = $(strip $(call _APPINFRA_BOOL_OF,$(strip $(call _APPINFRA_LOWER,$($(1))))))
_APPINFRA_BOOL_OF = $(if $(filter 1,$(words $(1))),\
    $(if $(filter $(_APPINFRA_TRUE),$(1)),true,$(if $(filter $(_APPINFRA_FALSE),$(1)),false)))

# One word of digits only (one call per check, so no line continuations: they
# would put spaces into the results)
_APPINFRA_NONDIGITS = $(strip $(subst 0,,$(subst 1,,$(subst 2,,$(subst 3,,$(subst 4,,$(subst 5,,$(subst 6,,$(subst 7,,$(subst 8,,$(subst 9,,$(1))))))))))))
_APPINFRA_IS_INT = $(and $(filter 1,$(words $(1))),$(if $(call _APPINFRA_NONDIGITS,$(1)),,1))
_APPINFRA_DIGIT_COUNT = $(words $(subst 0,0 ,$(subst 1,1 ,$(subst 2,2 ,$(subst 3,3 ,$(subst 4,4 ,$(subst 5,5 ,$(subst 6,6 ,$(subst 7,7 ,$(subst 8,8 ,$(subst 9,9 ,$(1))))))))))))
# A percent split at its dot into tokens: INT or INT . INT, at most 100
_APPINFRA_IS_DECIMAL_T = $(and $(call _APPINFRA_IS_INT,$(word 1,$(1))),$(filter 1 3,$(words $(1))),$(if $(word 2,$(1)),$(and $(filter .,$(word 2,$(1))),$(call _APPINFRA_IS_INT,$(word 3,$(1)))),1))
_APPINFRA_LE100_T = $(or $(filter 1 2,$(call _APPINFRA_DIGIT_COUNT,$(word 1,$(1)))),$(and $(filter 100,$(word 1,$(1))),$(if $(subst 0,,$(word 3,$(1))),,1)))
_APPINFRA_IS_PERCENT = $(and $(filter 1,$(words $(1))),$(call _APPINFRA_IS_DECIMAL_T,$(subst ., . ,$(1))),$(call _APPINFRA_LE100_T,$(subst ., . ,$(1))))
_APPINFRA_IS_WORKERS = $(or $(if $(strip $(1)),,1),$(and $(filter 1,$(words $(1))),$(filter auto logical,$(1))),$(and $(call _APPINFRA_IS_INT,$(1)),$(if $(filter 0%,$(1)),,1)))
# $(call _APPINFRA_INVALID,NAME,MESSAGE_VAR): the message is passed by name,
# since a comma in it would split the call's arguments
_APPINFRA_INVALID = $(error $(1)=$($(1)) is not $($(2)))
_APPINFRA_MSG_BOOLEAN := a boolean: use true, 1, y, yes or false, 0, n, no
_APPINFRA_MSG_MODE := a mode: use false, warn or strict
_APPINFRA_MSG_PERCENT := a percent: use a number from 0 to 100, e.g. 80 or 95.5
_APPINFRA_MSG_INTEGER := an integer: use a whole number, 0 or more
_APPINFRA_MSG_WORKERS := a worker count: use auto, logical or a whole number above 0

# $(call _APPINFRA_BOOL_VALUE,NAME): true or false; stops make on any other value
_APPINFRA_BOOL_VALUE = $(or $(call _APPINFRA_BOOL,$(1)),$(call _APPINFRA_INVALID,$(1),_APPINFRA_MSG_BOOLEAN))
# $(call _APPINFRA_ON,NAME): non-empty when the boolean setting NAME is on
_APPINFRA_ON = $(filter true,$(call _APPINFRA_BOOL_VALUE,$(1)))
# $(call _APPINFRA_MODE_VALUE,NAME): false, warn or strict; stops make on any other value
_APPINFRA_MODE_VALUE = $(or $(if $(filter 1,$(words $($(1)))),$(filter false warn strict,$(strip $(call _APPINFRA_LOWER,$($(1)))))),$(call _APPINFRA_INVALID,$(1),_APPINFRA_MSG_MODE))

$(foreach _APPINFRA_V,$(_APPINFRA_BOOLEANS),$(if $(call _APPINFRA_BOOL_VALUE,$(_APPINFRA_V)),))
$(foreach _APPINFRA_V,$(_APPINFRA_MODES),$(if $(call _APPINFRA_MODE_VALUE,$(_APPINFRA_V)),))
$(foreach _APPINFRA_V,$(_APPINFRA_PERCENTS),$(if $(call _APPINFRA_IS_PERCENT,$($(_APPINFRA_V))),,\
    $(call _APPINFRA_INVALID,$(_APPINFRA_V),_APPINFRA_MSG_PERCENT)))
$(foreach _APPINFRA_V,$(_APPINFRA_INTEGERS),$(if $(call _APPINFRA_IS_INT,$($(_APPINFRA_V))),,\
    $(call _APPINFRA_INVALID,$(_APPINFRA_V),_APPINFRA_MSG_INTEGER)))
$(foreach _APPINFRA_V,$(_APPINFRA_WORKERS),$(if $(call _APPINFRA_IS_WORKERS,$($(_APPINFRA_V))),,\
    $(call _APPINFRA_INVALID,$(_APPINFRA_V),_APPINFRA_MSG_WORKERS)))
export $(_APPINFRA_BOOLEANS) $(_APPINFRA_MODES)

# ============================================================================
# Config Target
# ============================================================================

##@ Configuration

# Each source (_APPINFRA_SOURCE) is environment, command-line, Makefile,
# Makefile.local or default; for the Python line, the default is python3 on
# PATH (Makefile.env).
# A value quoted for a single-quoted shell word
_APPINFRA_SQ = '$(subst ','\'',$(1))'

# The listing is generated from .VARIABLES, so it holds every APPINFRA_*
# setting without a second list to keep in step
config: ## Show the interpreter, every APPINFRA_* setting with its source, and INFRA_* overrides
	@echo "Configuration"
	@echo "============="
	@echo ""
	@echo "Python:          $(if $(PYTHON),$(PYTHON) ($(or $(_APPINFRA_PYTHON_SOURCE),$(call _APPINFRA_SOURCE,PYTHON))),(not resolved: Makefile.env not included))"
	@$(if $(PYTHON),echo "Version:         $$($(PYTHON) --version 2>&1)")
	@echo "Local overrides: $(or $(_APPINFRA_LOCAL_FILE),(no Makefile.local))"
	@echo ""
	@echo "Settings (APPINFRA_*):"
	@printf '  %-36s %-15s %s\n' SETTING SOURCE VALUE
	@$(foreach _APPINFRA_V,$(sort $(filter-out $(_APPINFRA_MACROS),$(filter APPINFRA_%,$(.VARIABLES)))),\
	    printf '  %-36s %-15s %s\n' $(_APPINFRA_V) $(call _APPINFRA_SOURCE,$(_APPINFRA_V)) \
	        $(call _APPINFRA_SQ,$($(_APPINFRA_V)));)
	@echo ""
	@echo "Config overrides (INFRA_*):"
	@$(if $(filter INFRA_%,$(.VARIABLES)),$(foreach _APPINFRA_V,$(sort $(filter INFRA_%,$(.VARIABLES))),\
	    printf '  %s=%s\n' $(_APPINFRA_V) $(call _APPINFRA_SQ,$($(_APPINFRA_V)));),echo "  (none)")
.PHONY: config
