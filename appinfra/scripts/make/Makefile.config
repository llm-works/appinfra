# Makefile.config - Configuration Protocol for Infra Makefile Framework
#
# This file provides:
# 1. Config file loading (Makefile.local for overrides)
# 2. Target filtering mechanism
# 3. Default values for all configuration variables
#
# Precedence (highest to lowest):
# 1. Environment variables
# 2. Makefile variables set before include
# 3. Makefile.local (optional overrides)
# 4. Defaults defined here
#
# For selective module inclusion, include individual Makefiles instead
# of using Makefile.all. See Makefile.all header for examples.
#
# Usage:
#   include path/to/Makefile.config
#   # or use Makefile.all which includes this automatically
#
# Makefile.env includes this file itself when a Makefile has not, so every
# layout loads Makefile.local, the defaults and the checks below.

_APPINFRA_CONFIG_LOADED := 1

# This file's directory, taken before any include changes MAKEFILE_LIST
_MAKEFILE_CONFIG_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

# ============================================================================
# Configuration File Loading
# ============================================================================

# Search for optional config file (Makefile.local for overrides)
_infra_config_file := $(strip \
    $(if $(wildcard $(CURDIR)/Makefile.local),$(CURDIR)/Makefile.local,))

# Include config file if found (uses ?= so env/Makefile vars take precedence)
ifneq ($(_infra_config_file),)
-include $(_infra_config_file)
endif

# ============================================================================
# Target Filtering
# ============================================================================

# Space-separated list of targets to disable (e.g., "pg.clean docs.serve")
APPINFRA_DISABLE_TARGETS ?=

# Space-separated list of target prefixes to disable (e.g., "pg. docs.")
APPINFRA_DISABLE_GROUPS ?=

# Helper macro to check if a target is disabled
# Usage: $(call _infra_check_target,target_name)
# Returns: shell command to exit 0 if disabled, empty otherwise
define _infra_check_target
$(if $(filter $1,$(APPINFRA_DISABLE_TARGETS)),@echo "Target '$1' is disabled via APPINFRA_DISABLE_TARGETS" && exit 0,$(if $(strip $(foreach g,$(APPINFRA_DISABLE_GROUPS),$(if $(filter $(g)%,$1),yes,))),@echo "Target '$1' is disabled via APPINFRA_DISABLE_GROUPS" && exit 0,))
endef

# ============================================================================
# Dry Run Mode
# ============================================================================

# Set APPINFRA_DRY_RUN=1 to show commands without executing
APPINFRA_DRY_RUN ?= 0

# Export for subprocesses (check.sh uses this)
export APPINFRA_DRY_RUN

# Helper macro for dry-run aware command execution
# Usage: $(call _run_or_show,command_description,actual_command)
define _run_or_show
@if [ "$(APPINFRA_DRY_RUN)" = "1" ]; then \
	echo "[DRY RUN] Would run: $(1)"; \
else \
	$(2); \
fi
endef

# ============================================================================
# Bootstrap Probes
# ============================================================================

# PyYAML availability probe. Some modules call helper scripts via $(shell ...)
# at parse time, and those scripts import yaml. During `make setup` from a fresh
# venv, PyYAML isn't installed yet — those modules must gate their parse-time
# shell-outs with `ifdef _INFRA_PYYAML_OK` so Make can finish parsing and run
# setup. Targets that depend on the parsed config will then work on the next
# invocation, once setup has installed dependencies.
_INFRA_PYYAML_OK := $(shell python3 -c "import yaml" 2>/dev/null && echo 1)

# ============================================================================
# Validation Helpers
# ============================================================================

# Validate APPINFRA_DEV_PKG_NAME points to a valid Python package
# Usage: $(call _validate_pkg_name,package_name)
# Call at the start of targets that require a valid package
define _validate_pkg_name
$(if $(wildcard $(1)/__init__.py),,$(error \
Package '$(1)' is not a valid Python package. \
Check APPINFRA_DEV_PKG_NAME in your Makefile. Run 'make doctor' for diagnostics.))
endef

# Check if a tool is available
# Usage: $(call _check_tool,tool_name,install_hint)
define _check_tool
@command -v $(1) >/dev/null 2>&1 || { \
	echo ""; \
	echo "ERROR: $(1) not found"; \
	echo ""; \
	echo "To fix: $(2)"; \
	echo ""; \
	exit 1; \
}
endef

# ============================================================================
# Default Values for Configuration Variables
# ============================================================================

# ENV module
APPINFRA_ENV_PYTHON ?=
# Note: Actual default handled in Makefile.env (detection logic)

# DEV module
APPINFRA_DEV_PKG_NAME ?= appinfra
APPINFRA_DEV_CQ_STRICT ?= false
APPINFRA_DEV_CQ_SPDX ?= false
APPINFRA_DEV_CQ_LINT_SELECT ?= C90,SIM,RET,PIE,PERF,FURB,C4
APPINFRA_DEV_CQ_DUP ?= warn
APPINFRA_DEV_CQ_DEAD ?= warn
APPINFRA_DEV_CHECK_EXAMPLES ?= false
APPINFRA_DEV_DOCSTRING_THRESHOLD ?= 80
APPINFRA_DEV_PROJECT_ROOT ?= $(CURDIR)
APPINFRA_DEV_CHECK_SCRIPT ?= $(_MAKEFILE_CONFIG_DIR)../check.sh
APPINFRA_DEV_CQ_EXCLUDE ?=
APPINFRA_DEV_INSTALL_EXTRAS ?=
APPINFRA_DEV_MYPY_FLAGS ?=
APPINFRA_DEV_SKIP_TARGETS ?=

# PYTEST module
APPINFRA_PYTEST_COVERAGE_PKG ?= $(APPINFRA_DEV_PKG_NAME)
APPINFRA_PYTEST_COVERAGE_MARKERS ?= unit
APPINFRA_PYTEST_COVERAGE_THRESHOLD ?= 80
APPINFRA_PYTEST_TESTS_DIR ?= tests
APPINFRA_PYTEST_PERF_DIR ?= tests
APPINFRA_PYTEST_WORKERS ?=
APPINFRA_PYTEST_ARGS ?=
APPINFRA_PYTEST_HANG_DUMP_SECONDS ?= 120

# Config module - ETC_DIR and default config file
ETC_DIR ?= $(CURDIR)/etc
APPINFRA_DEFAULT_CONFIG_FILE ?= infra.yaml

# DOCS module (empty = use APPINFRA_DEFAULT_CONFIG_FILE)
APPINFRA_DOCS_CONFIG_FILE ?=
APPINFRA_DOCS_OUTPUT_DIR ?= .site

# PG module (empty = use APPINFRA_DEFAULT_CONFIG_FILE)
APPINFRA_PG_CONFIG_FILE ?=
APPINFRA_PG_CONFIG_KEY ?= pgserver
APPINFRA_PG_DATABASES ?=
APPINFRA_PG_HOST ?= 127.0.0.1
APPINFRA_PG_USER ?= postgres

# Container runtime (used by the PG module)
# Override examples (Podman):
#   APPINFRA_CONTAINER_CMD := podman
#   APPINFRA_COMPOSE_CMD   := podman compose
APPINFRA_CONTAINER_CMD ?= docker
APPINFRA_COMPOSE_CMD ?= docker compose

# Export so helper shell scripts (pg.sh) inherit the runtime
export APPINFRA_CONTAINER_CMD
export APPINFRA_COMPOSE_CMD

# CLEAN module
APPINFRA_CLEAN_PRESERVE ?= .data .logs .GRADING.md

# UTILS module: 1 skips the confirmation prompt of destructive targets
APPINFRA_NO_CONFIRM ?=

# ============================================================================
# Renamed Variable Check
# ============================================================================

# Every framework variable is declared above as APPINFRA_*; INFRA_* is the
# config-override prefix. INFRA_X with a declared APPINFRA_X is that
# variable's name from before the rename, which the framework would ignore,
# so it stops make from any origin (a makefile, Makefile.local, the
# environment, the command line). Any other INFRA_* is a config override and
# passes. An assignment placed after the include of this file is not seen.
_infra_renamed := $(foreach v,$(filter INFRA_%,$(.VARIABLES)),\
    $(if $(filter-out undefined,$(origin APPINFRA_$(v:INFRA_%=%))),$(v)))
ifneq ($(strip $(_infra_renamed)),)
$(error $(foreach v,$(_infra_renamed),$(v) is renamed to APPINFRA_$(v:INFRA_%=%);) \
    INFRA_* is for config overrides)
endif

# ============================================================================
# Config Target
# ============================================================================

##@ Configuration

config: ## Show current infra framework configuration
	@echo "Infra Framework Configuration"
	@echo "=============================="
	@echo ""
	@echo "Config file: $(if $(_infra_config_file),$(_infra_config_file),(none found))"
	@echo ""
	@echo "Target Filtering:"
	@echo "  APPINFRA_DISABLE_TARGETS: $(if $(APPINFRA_DISABLE_TARGETS),$(APPINFRA_DISABLE_TARGETS),(none))"
	@echo "  APPINFRA_DISABLE_GROUPS:  $(if $(APPINFRA_DISABLE_GROUPS),$(APPINFRA_DISABLE_GROUPS),(none))"
	@echo ""
	@echo "Development (DEV):"
	@echo "  APPINFRA_DEV_PKG_NAME:           $(APPINFRA_DEV_PKG_NAME)"
	@echo "  APPINFRA_DEV_CQ_STRICT:          $(APPINFRA_DEV_CQ_STRICT)"
	@echo "  APPINFRA_DEV_CQ_SPDX:            $(APPINFRA_DEV_CQ_SPDX)"
	@echo "  APPINFRA_DEV_CQ_LINT_SELECT:     $(APPINFRA_DEV_CQ_LINT_SELECT)"
	@echo "  APPINFRA_DEV_CQ_DUP:             $(APPINFRA_DEV_CQ_DUP)"
	@echo "  APPINFRA_DEV_CQ_DEAD:            $(APPINFRA_DEV_CQ_DEAD)"
	@echo "  APPINFRA_DEV_CHECK_EXAMPLES:     $(APPINFRA_DEV_CHECK_EXAMPLES)"
	@echo "  APPINFRA_DEV_DOCSTRING_THRESHOLD: $(APPINFRA_DEV_DOCSTRING_THRESHOLD)"
	@echo "  APPINFRA_DEV_PROJECT_ROOT:       $(APPINFRA_DEV_PROJECT_ROOT)"
	@echo ""
	@echo "Testing (PYTEST):"
	@echo "  APPINFRA_PYTEST_COVERAGE_PKG:       $(APPINFRA_PYTEST_COVERAGE_PKG)"
	@echo "  APPINFRA_PYTEST_COVERAGE_THRESHOLD: $(APPINFRA_PYTEST_COVERAGE_THRESHOLD)"
	@echo "  APPINFRA_PYTEST_TESTS_DIR:          $(APPINFRA_PYTEST_TESTS_DIR)"
	@echo "  APPINFRA_PYTEST_PERF_DIR:           $(APPINFRA_PYTEST_PERF_DIR)"
	@echo "  APPINFRA_PYTEST_WORKERS:            $(if $(APPINFRA_PYTEST_WORKERS),$(APPINFRA_PYTEST_WORKERS),(none))"
	@echo "  APPINFRA_PYTEST_ARGS:               $(if $(APPINFRA_PYTEST_ARGS),$(APPINFRA_PYTEST_ARGS),(none))"
	@echo "  APPINFRA_PYTEST_HANG_DUMP_SECONDS:  $(APPINFRA_PYTEST_HANG_DUMP_SECONDS)"
	@echo ""
	@echo "Config:"
	@echo "  ETC_DIR:                   $(ETC_DIR)"
	@echo "  APPINFRA_DEFAULT_CONFIG_FILE: $(APPINFRA_DEFAULT_CONFIG_FILE)"
	@echo ""
	@echo "Documentation (DOCS):"
	@echo "  APPINFRA_DOCS_CONFIG_FILE: $(if $(APPINFRA_DOCS_CONFIG_FILE),$(APPINFRA_DOCS_CONFIG_FILE),(using default))"
	@echo "  APPINFRA_DOCS_OUTPUT_DIR:  $(APPINFRA_DOCS_OUTPUT_DIR)"
	@echo ""
	@echo "PostgreSQL (PG):"
	@echo "  APPINFRA_PG_CONFIG_FILE: $(if $(APPINFRA_PG_CONFIG_FILE),$(APPINFRA_PG_CONFIG_FILE),(using default))"
	@echo "  APPINFRA_PG_CONFIG_KEY:  $(APPINFRA_PG_CONFIG_KEY)"
	@echo "  APPINFRA_PG_HOST:       $(APPINFRA_PG_HOST)"
	@echo "  APPINFRA_PG_USER:       $(APPINFRA_PG_USER)"
	@echo "  APPINFRA_PG_DATABASES:  $(if $(APPINFRA_PG_DATABASES),$(APPINFRA_PG_DATABASES),(none))"
	@echo ""
	@echo "Container Runtime:"
	@echo "  APPINFRA_CONTAINER_CMD: $(APPINFRA_CONTAINER_CMD)"
	@echo "  APPINFRA_COMPOSE_CMD:   $(APPINFRA_COMPOSE_CMD)"
	@echo ""
	@echo "Cleanup (CLEAN):"
	@echo "  APPINFRA_CLEAN_PRESERVE: $(APPINFRA_CLEAN_PRESERVE)"
.PHONY: config
