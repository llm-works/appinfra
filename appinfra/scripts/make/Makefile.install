# Makefile.install - Package installation targets
#
# Provides install, install.e (editable), and uninstall targets.
# Separate from Makefile.dev so projects can use dev tools without package install.
#
# The targets run ../install_pkg.py with $(PYTHON) over $(APPINFRA_PYTHON_ENVS).
# `install` builds a wheel per env, installs it, and publishes a copy to
# <sys.prefix>/share/$(APPINFRA_DEV_PKG_NAME)/wheels/, which consumers (e.g.
# container builds) can pull from instead of the dev checkout. share/'s mode
# bits set the modes of what is published under it. share/ must exist, except
# in a virtualenv, where it is created 0755; every env is checked before any is
# changed, so a refused env leaves all of them as they were. install_pkg.py's
# docstring has the details.
#
# Required variables:
#   APPINFRA_DEV_PKG_NAME - Package name to install/uninstall
#   APPINFRA_PYTHON_ENVS           - Python environments to install to
#
# Optional variables:
#   APPINFRA_DEV_INSTALL_EXTRAS - Comma-separated extras (e.g., "dev,ui")

# Directory of this file; the includes below change MAKEFILE_LIST
_APPINFRA_INSTALL_MAKE_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

# Defaults are declared in Makefile.config; load it when the project has not
ifndef _APPINFRA_CONFIG_LOADED
include $(_APPINFRA_INSTALL_MAKE_DIR)Makefile.config
endif

# The recipes run install_pkg.py with $(PYTHON); resolve it when Makefile.env
# has not been included
ifndef PYTHON
include $(_APPINFRA_INSTALL_MAKE_DIR)Makefile.env
endif

# APPINFRA_DEV_PKG_NAME goes into the install recipes' shell commands, so it is
# checked here, before any recipe runs. PEP 503 normalized distribution names:
# start and end with alphanumeric; inner chars may be alphanumeric, `.`, `-`, `_`.
# install_pkg.py repeats the check (PKG_NAME) for the share/<pkg> path.
ifeq ($(shell echo "$(APPINFRA_DEV_PKG_NAME)" | grep -qE '^([A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._-]*[A-Za-z0-9])$$' && echo ok),)
$(error APPINFRA_DEV_PKG_NAME='$(APPINFRA_DEV_PKG_NAME)' must be a PEP 503 distribution name (alphanumeric, `.`, `-`, `_`; must start and end with alphanumeric))
endif

##@ Package Installation

_APPINFRA_INSTALL_PKG = $(PYTHON) $(_APPINFRA_INSTALL_MAKE_DIR)../install_pkg.py \
	--pkg '$(APPINFRA_DEV_PKG_NAME)' --extras '$(APPINFRA_DEV_INSTALL_EXTRAS)'

install:: areyousure ## installs $(APPINFRA_DEV_PKG_NAME) to all environments; emits wheel to dist/ and $$VENV/share/$(APPINFRA_DEV_PKG_NAME)/wheels/
	@$(_APPINFRA_INSTALL_PKG) install $(APPINFRA_PYTHON_ENVS)
.PHONY: install

install.e:: areyousure ## installs $(APPINFRA_DEV_PKG_NAME) (editable) to all environments in APPINFRA_PYTHON_ENVS
	@$(_APPINFRA_INSTALL_PKG) install-e $(APPINFRA_PYTHON_ENVS)
.PHONY: install.e

uninstall:: areyousure ## uninstalls $(APPINFRA_DEV_PKG_NAME) from all environments in APPINFRA_PYTHON_ENVS
	@$(_APPINFRA_INSTALL_PKG) uninstall $(APPINFRA_PYTHON_ENVS)
.PHONY: uninstall

reinstall:: areyousure ## uninstall then install (cleans orphaned files)
	@$(_APPINFRA_INSTALL_PKG) reinstall $(APPINFRA_PYTHON_ENVS)
.PHONY: reinstall
