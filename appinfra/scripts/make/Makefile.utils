# Makefile.utils - Reusable Utility Functions
#
# Provides: areyousure function and target
#
# Usage in other Makefiles:
#   dangerous_target: areyousure
#       @echo "doing something dangerous"

# APPINFRA_YES is a boolean setting, already true or false (Makefile.config)
ifndef _APPINFRA_CONFIG_LOADED
include $(dir $(lastword $(MAKEFILE_LIST)))Makefile.config
endif

# APPINFRA_YES=true answers yes without asking; otherwise the prompt takes y or
# yes (any case). Patterns, not ${var,,}: the recipe shell is /bin/sh
define _APPINFRA_AREYOUSURE
	@if [ "$(APPINFRA_YES)" = "true" ]; then \
		echo "APPINFRA_YES=true, skipping confirmation"; \
	else \
		printf "Are you sure? [y/N] " && read ans && \
		case "$$ans" in [Yy]|[Yy][Ee][Ss]) ;; *) exit 1;; esac; \
	fi
endef

areyousure:
	$(call _APPINFRA_AREYOUSURE)
.PHONY: areyousure
