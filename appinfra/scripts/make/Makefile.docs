# Makefile.docs - Documentation Targets (MkDocs)
#
# Provides: docs.serve, docs.check, docs.build, docs.deploy
# Requires: PYTHON (from Makefile.env), areyousure (from Makefile.utils)
#
# Configuration variables (set in Makefile before include):
#   APPINFRA_DOCS_CONFIG_FILE - Config filename (empty = use APPINFRA_DEFAULT_CONFIG_FILE)
#   APPINFRA_DOCS_OUTPUT_DIR  - Output directory for build (default: .site)

# Path to this Makefile's directory, taken before the include below changes
# MAKEFILE_LIST
_APPINFRA_DOCS_MAKE_DIR := $(dir $(realpath $(lastword $(MAKEFILE_LIST))))

# Defaults are declared in Makefile.config; load it when the project has not
ifndef _APPINFRA_CONFIG_LOADED
include $(_APPINFRA_DOCS_MAKE_DIR)Makefile.config
endif

# Resolve mkdocs config path using docs-config.sh
# If APPINFRA_DOCS_CONFIG_FILE is set, use it directly from APPINFRA_ETC_DIR
# If empty, extract 'docs' section from APPINFRA_DEFAULT_CONFIG_FILE
# Recursive (=) on purpose: resolved only when a docs.* recipe expands it, so
# parsing (every other target, and `make setup` before PyYAML is installed)
# never runs the script or prints its errors.
_APPINFRA_MKDOCS_CONFIG = $(shell CURDIR=$(CURDIR) $(_APPINFRA_DOCS_MAKE_DIR)/../docs-config.sh "$(APPINFRA_DOCS_CONFIG_FILE)" $(APPINFRA_ETC_DIR) $(APPINFRA_DEFAULT_CONFIG_FILE))

##@ Documentation

docs.serve:: ## Serve documentation with live reload
	$(PYTHON) -m mkdocs serve -f $(_APPINFRA_MKDOCS_CONFIG)
.PHONY: docs.serve

docs.check:: ## Validate documentation without permanent output
	@echo "* validating documentation build..."
	@$(PYTHON) -m mkdocs build -f $(_APPINFRA_MKDOCS_CONFIG) -d /tmp/infra-mkdocs-check -q
	@rm -rf /tmp/infra-mkdocs-check
	@echo "* documentation validation passed"
.PHONY: docs.check

docs.build:: ## Build static documentation site
	$(PYTHON) -m mkdocs build -f $(_APPINFRA_MKDOCS_CONFIG) -d $(APPINFRA_DOCS_OUTPUT_DIR)
.PHONY: docs.build

docs.deploy:: areyousure ## Deploy documentation to GitHub Pages
	$(PYTHON) -m mkdocs gh-deploy -f $(_APPINFRA_MKDOCS_CONFIG)
.PHONY: docs.deploy
