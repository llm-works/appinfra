# {{PROJECT_NAME}} - Framework-based Makefile
#
# This Makefile includes modular components from the infra framework.
# Generated with infra scaffold tool using --makefile-style=framework

# Configuration
APPINFRA_DEV_PKG_NAME := {{PROJECT_NAME}}

# Auto-detect infra framework location (override by setting APPINFRA_ROOT env var or in Makefile)
APPINFRA_ROOT ?=

# Check common submodule location
ifeq ($(APPINFRA_ROOT),)
  ifneq (,$(wildcard ./submodules/infra/scripts/make/Makefile.env))
    APPINFRA_ROOT := ./submodules/infra
  endif
endif

# Auto-detect via Python import
_BOOTSTRAP_PYTHON := $(or $(PYTHON),$(wildcard $(HOME)/.venv/bin/python),python3)

ifeq ($(APPINFRA_ROOT),)
  APPINFRA_ROOT := $(shell $(_BOOTSTRAP_PYTHON) -c "import appinfra; from pathlib import Path; print(Path(appinfra.__file__).parent.parent)" 2>/dev/null || echo "")
endif

ifeq ($(APPINFRA_ROOT),)
  $(error Cannot locate infra. Set APPINFRA_ROOT=/path/to/infra at top of Makefile or install appinfra package)
endif

# Include framework Makefiles (Makefile.env handles Python detection)
include $(APPINFRA_ROOT)/scripts/make/Makefile.env
include $(APPINFRA_ROOT)/scripts/make/Makefile.help
include $(APPINFRA_ROOT)/scripts/make/Makefile.utils
include $(APPINFRA_ROOT)/scripts/make/Makefile.clean
include $(APPINFRA_ROOT)/scripts/make/Makefile.dev
include $(APPINFRA_ROOT)/scripts/make/Makefile.pytest
# Uncomment if using PostgreSQL; the pg targets read the pgserver section of
# $(ETC_DIR)/$(APPINFRA_DEFAULT_CONFIG_FILE), which the scaffold keeps inside the package:
# ETC_DIR := $(CURDIR)/$(APPINFRA_DEV_PKG_NAME)/etc
# include $(APPINFRA_ROOT)/scripts/make/Makefile.pg

##@ Application

run:: ## runs the application
	@echo "* running application..."
	@$(PYTHON) -m {{PROJECT_NAME}}
.PHONY: run
