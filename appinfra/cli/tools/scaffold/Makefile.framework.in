# {{PROJECT_NAME}} - Framework-based Makefile
#
# This Makefile includes modular components from the appinfra framework.
# Generated with infra scaffold tool using --makefile-style=framework

# Configuration
APPINFRA_DEV_PKG_NAME ?= {{PROJECT_NAME}}
# The scaffold keeps the config (etc/infra.yaml) inside the package
APPINFRA_ETC_DIR ?= $(CURDIR)/$(APPINFRA_DEV_PKG_NAME)/etc

# appinfra's scripts directory (what `appinfra scripts-path` prints), located
# through the interpreter that has appinfra installed. Set APPINFRA_SCRIPTS
# to use another copy, e.g. a submodule: submodules/appinfra/appinfra/scripts
APPINFRA_SCRIPTS ?= $(shell $(or $(APPINFRA_PYTHON),$(PYTHON),$(wildcard $(HOME)/.venv/bin/python),python3) \
    -c "from importlib.resources import files; print(files('appinfra') / 'scripts')" 2>/dev/null)
ifeq ($(APPINFRA_SCRIPTS),)
  $(error Cannot locate appinfra. Install the appinfra package or set APPINFRA_SCRIPTS=/path/to/appinfra/scripts)
endif

# Include framework Makefiles (Makefile.config loads Makefile.local and the
# defaults; Makefile.env resolves the Python interpreter)
include $(APPINFRA_SCRIPTS)/make/Makefile.config
include $(APPINFRA_SCRIPTS)/make/Makefile.env
include $(APPINFRA_SCRIPTS)/make/Makefile.help
include $(APPINFRA_SCRIPTS)/make/Makefile.utils
include $(APPINFRA_SCRIPTS)/make/Makefile.clean
include $(APPINFRA_SCRIPTS)/make/Makefile.dev
include $(APPINFRA_SCRIPTS)/make/Makefile.pytest
# Uncomment if using PostgreSQL; the pg targets read the pgserver section of
# $(APPINFRA_ETC_DIR)/$(APPINFRA_DEFAULT_CONFIG_FILE):
# include $(APPINFRA_SCRIPTS)/make/Makefile.pg

##@ Application

run:: ## runs the application
	@echo "* running application..."
	@$(PYTHON) -m {{PROJECT_NAME}}
.PHONY: run
